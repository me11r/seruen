# Node.js 22+. Copy to .env. Never commit real credentials.
# Optional: empty means clearly labelled deterministic demo mode.
OPENAI_API_KEY=
# A model available to your account, supporting Responses structured outputs.
OPENAI_MODEL=gpt-4.1-mini
# Optional PUBLIC browser key for 2GIS MapGL JS. Restrict by domain in 2GIS.
# Does not grant Places/Search or Routing API access. Neither is used here.
TWOGIS_MAP_KEY=
PORT=3000
HOST=0.0.0.0
